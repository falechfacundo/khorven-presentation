---
import '../styles/global.css';
import PropuestaView from '@/components/react/PropuestaView';
import type { Prospecto } from '@data/prospectos';

interface Props {
  prospecto: Prospecto;
  title: string;
  /** Las propuestas por cliente no se indexan; la raíz sí. */
  indexable?: boolean;
}

const { prospecto, title, indexable = false } = Astro.props;
---

<!doctype html>
<html lang="es" style="background-color:#060608">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={prospecto.dolorPrincipal} />
    {!indexable && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content={prospecto.colorTema} />
    {prospecto.logoUrl && <link rel="icon" href={prospecto.logoUrl} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body>
    <PropuestaView client:load prospecto={prospecto} />
  </body>
</html>
